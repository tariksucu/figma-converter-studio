{
  // The plugin's code as Figma runs it (code.js): in Figma's sandbox, with the `figma` API, the
  // language's own objects and no DOM. Checked against Figma's official typings without the
  // DOM's types, so any use of `window`, `document` or the like is an error here, not in Figma.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "types": ["@figma/plugin-typings"]
  },
  "include": ["src/code", "src/shared"]
}
